{
    "name": "juanchosl/compression",
    "description": "Grouped tools in order to abstract compression tasks compatible with few formats and encodings.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/Compression",
    "keywords": [
        "compression",
        "zlib",
        "deflate",
        "gzip",
        "zstd",
        "raw"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "juanchosl/exceptions": "1.0.*",
        "juanchosl/validators": "1.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.*",
        "phpstan/phpstan": "1.12.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\Compression\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\Compression\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}